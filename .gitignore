# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
# Alternate build dir, for profiling a production build while `next dev` owns
# `.next` — see `distDir` in next.config.ts.
/.next-prod/
/out/
next-env.d.ts

# production
/build

# driver output (.claude/skills/run-aarnaa-studios/driver.mjs)
/.screenshots/

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
#
# `.env` is COMMITTED and is the file Next actually loads — it holds the public
# Sanity settings and nothing secret. `.env.local` is not, and holds the two
# values that are. See the header of `.env`.
.env*
!.env

# typescript
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json
.idea
.claude/worktrees/selected-works-polish
