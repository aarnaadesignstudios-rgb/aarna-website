# ──────────────────────────────────────────────────────────────────────────
#  Aarnaa Design Studios — environment
#
#  THIS FILE IS COMMITTED, AND IT IS THE ONE NEXT ACTUALLY READS.
#
#  It replaced `.env.example`, which was a template nobody's checkout ever
#  loaded: Next reads `.env`, `.env.local`, `.env.development` and
#  `.env.production` and ignores anything else, so the old arrangement meant a
#  fresh clone ran on the committed constants until someone remembered to copy
#  a file. There is nothing to copy now — clone, `npm install`, `npm run dev`,
#  and the Studio is connected.
#
#  ── NEVER PUT A SECRET IN HERE ───────────────────────────────────────────
#
#  Everything below is public by construction (see the note on each one).
#  The two values that are NOT public live in `.env.local`, which is
#  git-ignored — and in Vercel's own environment variables in production.
#  There is a list of them at the bottom of this file.
#
#  ── Precedence, which is what makes this safe ────────────────────────────
#
#  `.env.local` beats `.env`, and a real environment variable beats both. So a
#  value set in Vercel's dashboard overrides anything written here, and this
#  file is a DEFAULT rather than a decision — point a preview deployment at a
#  different dataset without touching the repo.
# ──────────────────────────────────────────────────────────────────────────


# ── Sanity ────────────────────────────────────────────────────────────────
#
# From sanity.io → your project → Settings → API.
#
# The project ID carries the NEXT_PUBLIC_ prefix because it is in the browser
# bundle either way: a free-plan dataset is world-readable, so the ID is not a
# secret and treating it as one would be theatre. That is also why it is safe
# to commit — see sanity/env.ts.

NEXT_PUBLIC_SANITY_PROJECT_ID=gozjhn5v

# Leave as `production` unless you deliberately made another dataset. Override
# it per environment in Vercel if a preview deployment should read a different
# one.
NEXT_PUBLIC_SANITY_DATASET=production

# The API's dated version. Pinned, not floating: an un-pinned version means a
# future Sanity release can change what a query returns without anything in
# this repo changing. Only move it when Sanity's docs tell you to.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01


# ── The secrets, which are NOT here ───────────────────────────────────────
#
# Both live in `.env.local` for local work and in Vercel → Settings →
# Environment Variables for the deployed site. Neither has a NEXT_PUBLIC_
# prefix, so neither ever reaches the browser.
#
#   SANITY_REVALIDATE_SECRET
#     A shared secret so that only Sanity can tell the site "this changed,
#     refetch it". The SAME string goes in the Sanity webhook's Secret field
#     and in Vercel. Without it the revalidate endpoint refuses every request,
#     which is the correct default — an open endpoint lets anyone force the
#     cache to flush on demand. Invent one with:
#
#         node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#   SANITY_API_READ_TOKEN
#     Optional, and only for previewing unpublished drafts. Published content
#     on a free (public) dataset needs no token at all. Create it at
#     Settings → API → Tokens with VIEWER permission — never Editor or Deploy
#     Studio, either of which would let anyone holding it write to the content.
