# ──────────────────────────────────────────────────────────────────────────
#  Aarnaa Studios — environment
#
#  COPY THIS FILE TO `.env.local` AND FILL IN THE VALUES.
#
#      cp .env.example .env.local
#
#  `.env.local` is git-ignored (see .gitignore). This file is committed, so it
#  must never contain a real value — it is the list of what is needed, not the
#  secrets themselves.
#
#  ── Nothing here is required to run the site ──────────────────────────────
#
#  With all of it blank the site runs exactly as it does today, serving the
#  photographs and copy in `constants/content.ts`. Sanity switches itself on
#  only when NEXT_PUBLIC_SANITY_PROJECT_ID has a value — see sanity/env.ts.
#  So a missing or half-finished setup degrades to the current site rather
#  than to a broken one.
# ──────────────────────────────────────────────────────────────────────────


# ── Sanity ────────────────────────────────────────────────────────────────
#
# Where to find these: sanity.io → your project → Settings → API.
#
# The project ID is public by design. It is in the browser bundle either way,
# which is why it carries the NEXT_PUBLIC_ prefix — a free-plan dataset is
# world-readable, so the ID is not a secret and must not be treated as one.

# Looks like: 3xa9b1cd
NEXT_PUBLIC_SANITY_PROJECT_ID=gozjhn5v

# Leave as `production` unless you deliberately made another dataset.
NEXT_PUBLIC_SANITY_DATASET=production

# The Studio's schema version. Only change this if Sanity's docs tell you to;
# it pins the API's behaviour so a future release cannot silently alter what
# the queries return.
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01


# ── Publishing ────────────────────────────────────────────────────────────
#
# A shared secret so that only Sanity can tell the site "this changed, refetch
# it". Without it the revalidate endpoint refuses every request, which is the
# correct default: an open endpoint lets anyone force your site to rebuild its
# cache on demand.
#
# Invent any long random string, put the SAME value here and in the Sanity
# webhook's secret field. For example:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SANITY_REVALIDATE_SECRET=


# ── Optional: reading drafts ──────────────────────────────────────────────
#
# Only needed if you later want to preview unpublished edits. Published content
# needs no token on a free (public) dataset. Create at Settings → API → Tokens
# with VIEWER permission — never Editor or Deploy Studio, which would let
# anyone holding it write to your content.
#
# This one is a real secret. It has no NEXT_PUBLIC_ prefix, so it stays on the
# server and never reaches the browser.

SANITY_API_READ_TOKEN=
